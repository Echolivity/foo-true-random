<?xml version="1.0" encoding="utf-8"?>
<!--
  foo_true_random — foobar2000 v2 component (Windows x64).

  Requires the official foobar2000 SDK 2026-10-01 extracted to
  external\foobar2000-sdk (see scripts\fetch-sdk.ps1), or pass
  /p:FB2K_SDK=<path-with-trailing-backslash> to MSBuild.

  Project settings mirror the SDK's own foo_sample.vcxproj (x64 configurations),
  minus the helpers/libPPUI/ATL dependencies, which this component does not use.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A797E819-A44B-4A26-B5B7-F6FCDFD2ED61}</ProjectGuid>
    <RootNamespace>foo_true_random</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup>
    <FB2K_SDK Condition="'$(FB2K_SDK)'==''">$(MSBuildThisFileDirectory)..\..\external\foobar2000-sdk\</FB2K_SDK>
    <FTR_ROOT>$(MSBuildThisFileDirectory)..\..\</FTR_ROOT>
    <!-- /p:FTR_ITEST=true builds the separate integration-test component
         (foo_true_random_itest.dll). It is never packaged or shipped. -->
    <FTR_ITEST Condition="'$(FTR_ITEST)'==''">false</FTR_ITEST>
    <FTR_DLL_BASENAME Condition="'$(FTR_ITEST)'!='true'">foo_true_random</FTR_DLL_BASENAME>
    <FTR_DLL_BASENAME Condition="'$(FTR_ITEST)'=='true'">foo_true_random_itest</FTR_DLL_BASENAME>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <TargetName>$(FTR_DLL_BASENAME)</TargetName>
    <OutDir>$(FTR_ROOT)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(FTR_ROOT)build\obj\$(Platform)\$(Configuration)\$(FTR_DLL_BASENAME)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <TreatSpecificWarningsAsErrors>4715</TreatSpecificWarningsAsErrors>
      <AdditionalIncludeDirectories>$(FB2K_SDK);$(FB2K_SDK)foobar2000;$(FTR_ROOT)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(FB2K_SDK)foobar2000\shared\shared-$(Platform).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <StringPooling>true</StringPooling>
      <PreprocessorDefinitions>NDEBUG;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Shipped component -->
    <ClCompile Include="main.cpp" Condition="'$(FTR_ITEST)'!='true'" />
    <ClCompile Include="commands.cpp" Condition="'$(FTR_ITEST)'!='true'" />
    <!-- Separate integration-test component: drives the INSTALLED shipped
         component through foobar2000's menu services. Never packaged. -->
    <ClCompile Include="itest.cpp" Condition="'$(FTR_ITEST)'=='true'" />
    <ClCompile Include="fb2k_backend.cpp" />
    <ClCompile Include="..\..\src\hardware_rng.cpp" />
    <ClCompile Include="..\..\src\hardware_rng_x86.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="stdafx.h" />
    <ClInclude Include="fb2k_backend.h" />
    <ClInclude Include="commands.h" />
    <ClInclude Include="guids.h" />
    <ClInclude Include="version.h" />
    <ClInclude Include="..\..\include\ftr\random_core.h" />
    <ClInclude Include="..\..\include\ftr\hardware_rng.h" />
    <ClInclude Include="..\..\include\ftr\playlist_logic.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- Project GUIDs as referenced by the SDK's foo_sample.vcxproj. -->
    <ProjectReference Include="$(FB2K_SDK)pfc\pfc.vcxproj">
      <Project>{ebfffb4e-261d-44d3-b89c-957b31a0bf9c}</Project>
    </ProjectReference>
    <ProjectReference Include="$(FB2K_SDK)foobar2000\SDK\foobar2000_SDK.vcxproj">
      <Project>{e8091321-d79d-4575-86ef-064ea1a4a20d}</Project>
    </ProjectReference>
    <ProjectReference Include="$(FB2K_SDK)foobar2000\foobar2000_component_client\foobar2000_component_client.vcxproj">
      <Project>{71ad2674-065b-48f5-b8b0-e1f9d3892081}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
